-  heap.positionGeneration[result.item] = 0
-  dec heap.len
-  if heap.len > 0:
-    heap.nodes[0] = heap.nodes[heap.len]
-    heap.setPosition(heap.nodes[0].item, 0)
-    heap.siftDown(0)
