-  inc store.count
-  store.hashGeneration[slot] = store.generation
-  store.hashKeys[slot] = key
-  store.hashRecords[slot] = result
-  store.keys[result] = key
-  store.closed[result] = false
-  store.gScore[result] = Inf
-  store.cameFrom[result] = -1
