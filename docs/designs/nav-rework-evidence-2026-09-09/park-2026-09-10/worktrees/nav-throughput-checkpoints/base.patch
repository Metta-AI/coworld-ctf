-proc swapNodes(heap: var FixedHeap, a, b: int) =
-  swap(heap.nodes[a], heap.nodes[b])
-  heap.setPosition(heap.nodes[a].item, a)
-  heap.setPosition(heap.nodes[b].item, b)
