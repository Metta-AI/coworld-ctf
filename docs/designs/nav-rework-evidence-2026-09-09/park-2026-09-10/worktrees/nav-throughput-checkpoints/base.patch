-proc nodeLess(a, b: HeapNode): bool =
-  if a.priority != b.priority: a.priority < b.priority
-  elif a.cost != b.cost: a.cost < b.cost
-  elif a.tie1 != b.tie1: a.tie1 < b.tie1
