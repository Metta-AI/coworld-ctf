+    result = cmp(a.cellIndex, b.cellIndex)
+    if result == 0:
+      result = cmp(a.pointRef, b.pointRef))
+  var unique: seq[FineAnchorPair]
+  for pair in pairs:
+    if unique.len == 0 or unique[^1].cellIndex != pair.cellIndex or
+        unique[^1].pointRef != pair.pointRef:
+      unique.add pair
