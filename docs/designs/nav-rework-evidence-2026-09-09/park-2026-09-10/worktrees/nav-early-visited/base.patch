+proc fineAnchorAt*(index: BodyRouteIndex, offset: int): int32 =
+  if offset < 0 or offset >= index.fineAnchors.len:
+    raise newException(IndexDefect, "route-index fine anchor is out of bounds")
+  index.fineAnchors[offset]
