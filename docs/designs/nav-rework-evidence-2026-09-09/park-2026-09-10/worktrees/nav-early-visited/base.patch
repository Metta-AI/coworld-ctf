+    return -1
+  let direction = index.portalNext[
+    metadata.fieldStart.int + index.localIndex[cellIndex].int]
+  if direction == NoHop:
+    return -1
+  let
+    cell = index.cellPoint(cellIndex)
+    delta = NavNeighbors[direction.int]
