-proc pyRound(value: float): int =
-  let lower = floor(value).int
-  let fraction = value - lower.float
-  if fraction < 0.5: lower
-  elif fraction > 0.5: lower + 1
-  elif (lower and 1) == 0: lower
-  else: lower + 1
