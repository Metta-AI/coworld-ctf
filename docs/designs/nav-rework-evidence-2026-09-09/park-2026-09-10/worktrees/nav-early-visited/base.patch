+proc roomSideAt*(index: BodyRouteIndex, offset: int): int =
+  if offset < 0 or offset >= index.roomSides.len:
+    raise newException(IndexDefect, "route-index room-side offset is out of bounds")
+  index.roomSides[offset].int
