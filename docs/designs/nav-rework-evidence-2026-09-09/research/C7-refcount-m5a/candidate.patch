+proc dangerSourceCacheOrder*(system: BodyNavSystem): seq[int] =
+  ## Diagnostic snapshot (never on the playing-tick path): cached origin
+  ## cell indices from least to most recently used. A hit moves its key to
+  ## the end; a miss on a full cache drops the front and appends.
+  var order: seq[tuple[lastUse: uint64, key: int]]
+  for slot in system.seats[0].dangerSourceCache.slots:
+    if slot.key >= 0:
+      order.add((slot.lastUse, slot.key.int))
+  order.sort(proc(a, b: tuple[lastUse: uint64, key: int]): int =
+    cmp(a.lastUse, b.lastUse))
+  for entry in order:
+    result.add entry.key
+
+proc dangerSourceCacheEntryBytes*(system: BodyNavSystem): int =
+  ## Bytes reserved for one slot's entry list at this system's live range
+  ## (capacity times entry size).
+  system.seats[0].dangerSourceCache.capacity * sizeof(DangerSourceEntry)
+
+proc dangerSourceCacheCapacity*(system: BodyNavSystem): int =
+  ## Entries per slot: the nonzero-kernel count at this system's range.
+  system.seats[0].dangerSourceCache.capacity
+
+proc dangerSourceCacheLengths*(system: BodyNavSystem): seq[int] =
+  ## Diagnostic snapshot: recorded entry count per occupied slot, in the
+  ## same least-to-most-recently-used order as dangerSourceCacheOrder.
+  var order: seq[tuple[lastUse: uint64, length: int]]
+  for slot in system.seats[0].dangerSourceCache.slots:
+    if slot.key >= 0:
+      order.add((slot.lastUse, slot.length.int))
+  order.sort(proc(a, b: tuple[lastUse: uint64, length: int]): int =
+    cmp(a.lastUse, b.lastUse))
+  for entry in order:
+    result.add entry.length
+
+when defined(dangerSourceCacheCounters):
+  proc dangerSourceCacheCounters*(system: BodyNavSystem): tuple[hits, misses: int] =
+    (system.seats[0].dangerSourceCache.hits,
+     system.seats[0].dangerSourceCache.misses)
