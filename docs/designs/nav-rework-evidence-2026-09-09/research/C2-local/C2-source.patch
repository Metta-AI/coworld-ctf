+proc sourceCacheSlot(cache: DangerSourceCache, key: int32): int =
+  ## Slot holding `key`, or -1. Linear scan: 64 compares against one
+  ## source's ray walk is negligible, and it keeps selection trivially
+  ## deterministic.
+  for slot in 0 ..< DangerSourceCacheSlots:
+    if cache.slots[slot].key == key:
+      return slot
+  -1
+
+proc sourceCacheVictim(cache: DangerSourceCache): int =
+  ## First empty slot, else the least recently used; ties (impossible under
+  ## the monotonic clock, kept for the empty case) resolve to the lowest
+  ## slot index.
+  result = 0
+  for slot in 0 ..< DangerSourceCacheSlots:
+    if cache.slots[slot].key < 0:
+      return slot
+    if cache.slots[slot].lastUse < cache.slots[result].lastUse:
+      result = slot
+
+proc replayVisibleCells(seat: BodyNavSeat, origin: BodyPoint, base: int) =
+  ## Hit path: the same kernel adds the ray walk would make for this origin,
+  ## in box row-major order instead of ray order. Exact because every cell
+  ## receives at most one kernel add per source and cells are independent.
+  ## Recorded cells were in-grid for this exact origin, so no bounds check.
+  let
+    cache = seat.dangerSourceCache
+    radius = seat.dangerGeometry.radius
+    diameter = radius * 2 + 1
+    gridW = seat.danger.gridW
+  for wordIndex in 0 ..< cache.words:
+    var word = cache.bits[base + wordIndex]
+    while word != 0:
+      let kernelIndex = wordIndex * 64 + countTrailingZeroBits(word)
+      let kernelY = kernelIndex div diameter
+      let kernelX = kernelIndex - kernelY * diameter
+      let gx = origin.x - radius + kernelX
+      let gy = origin.y - radius + kernelY
+      seat.danger.values[gy * gridW + gx] +=
+        seat.dangerGeometry.kernel[kernelIndex]
+      word = word and (word - 1)
+
