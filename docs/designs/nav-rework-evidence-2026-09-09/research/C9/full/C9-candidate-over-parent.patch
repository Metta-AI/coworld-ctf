+proc replayListEntries(seat: BodyNavSeat, slot: int) =
+  ## Later hits: the materialized nonzero adds, in list order. Zero-weight
+  ## cells were adds of +0.0 (exact identity on this nonnegative finite
+  ## raster) and are absent from the list.
+  let base = slot * seat.dangerSourceCache.capacity
+  for offset in base ..< base + seat.dangerSourceCache.slots[slot].listLength.int:
+    let entry = seat.dangerSourceCache.entries[offset]
