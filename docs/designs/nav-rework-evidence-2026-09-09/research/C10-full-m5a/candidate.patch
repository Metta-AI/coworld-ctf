+proc dangerSourceCacheOrder*(system: BodyNavSystem): seq[int] =
+  ## Diagnostic snapshot (never on the playing-tick path): cached origin
+  ## cell indices from least to most recently used. A hit moves its key to
+  ## the end; a miss on a full cache drops the front and appends.
+  var order: seq[tuple[lastUse: uint64, key: int]]
+  for slot in system.seats[0].dangerSourceCache.slots:
+    if slot.key >= 0:
+      order.add((slot.lastUse, slot.key.int))
+  order.sort(proc(a, b: tuple[lastUse: uint64, key: int]): int =
+    cmp(a.lastUse, b.lastUse))
+  for entry in order:
+    result.add entry.key
