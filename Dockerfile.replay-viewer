# Build the static replay viewer with the same pinned Nim and Bitworld sources
# as the native game. The output is architecture-neutral WebAssembly even
# though this reproducible toolchain container runs as linux/amd64.
FROM emscripten/emsdk:4.0.15 AS replay-viewer-builder

RUN apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates curl git && \
  rm -rf /var/lib/apt/lists/* && \
  curl -fsSL \
    -o /usr/local/bin/nimby \
    https://github.com/treeform/nimby/releases/download/0.1.27/nimby-Linux-X64 && \
  echo "3b3084394bd26b09f84a3f82389f075221c8784893238390939d71dd66ac9e8b  /usr/local/bin/nimby" | sha256sum -c - && \
  chmod +x /usr/local/bin/nimby && \
  nimby use 2.2.4

ENV PATH="/root/.nimby/nim/bin:$PATH"

WORKDIR /workspace/ctf
COPY nimby.lock .
RUN nimby --global sync nimby.lock

COPY . .
# The per-biome floor textures ride into the wasm bundle through
# replay-viewer/config.nims' `--preload-file data@data`, so unlike the soldier
# PNGs below they are never copied to dist/ and a `test -f dist/...` guard
# cannot see them. Guard the SOURCE files instead, before the build: .gitignore
# opens with `*`, so a freshly generated PNG is silently left untracked, and a
# missing tile takes out only the maps on that one biome (loadBiomeFloor names
# it, but a fail-fast here is cheaper than a mystery boot crash in the field).
RUN test -f data/arena_floor.png && \
  test -f data/arena_floor_caves.png && \
  test -f data/arena_floor_forest.png && \
  test -f data/arena_floor_desert.png && \
  test -f data/arena_floor_city.png && \
  test -f data/arena_floor_plains.png
RUN nim c -d:emscripten replay-viewer/ctf_replay.nim && \
  nim c -r --hints:off -o:/tmp/gen_wire_constants tools/gen_wire_constants.nim \
    > replay-viewer/dist/wire_constants.js && \
  cp client/broadcast_core.js replay-viewer/dist/broadcast_core.js && \
  cp client/chrome_common.js replay-viewer/dist/chrome_common.js && \
  cp data/font.ttf replay-viewer/dist/font.ttf && \
  cp replay-viewer/static_replay.js replay-viewer/dist/static_replay.js && \
  sed -e 's|<!-- WIRE_CONSTANTS -->|<script src="./wire_constants.js"></script>|' \
      -e 's|<!-- CHROME_COMMON -->|<script src="./chrome_common.js"></script>|' \
      -e 's|<!-- BROADCAST_CORE -->|<script src="./broadcast_core.js"></script><script src="./static_replay.js"></script><script src="./ctf_replay.js"></script>|' \
    client/replay_broadcast.html > replay-viewer/dist/index.html && \
  sed -e 's|<!-- WIRE_CONSTANTS -->|<script src="./wire_constants.js"></script>|' \
      -e 's|<!-- CHROME_COMMON -->|<script src="./chrome_common.js"></script>|' \
    client/league_replayer.html > replay-viewer/dist/league.html && \
  cp data/soldier_red_front.png data/soldier_blue_front.png \
    data/soldier_green_front.png data/soldier_yellow_front.png \
    data/soldier_red_front_gun.png data/soldier_blue_front_gun.png \
    data/soldier_green_front_gun.png data/soldier_yellow_front_gun.png \
    replay-viewer/dist/ && \
  mkdir -p replay-viewer/dist/art/walls replay-viewer/dist/art/lockerroom && \
  cp client/art/walls/wall_h.jpg client/art/walls/wall_v.jpg \
    replay-viewer/dist/art/walls/ && \
  cp client/art/lockerroom/bg.jpg client/art/lockerroom/*.webp \
    replay-viewer/dist/art/lockerroom/ && \
  rm -rf replay-viewer/dist/nimcache && \
  test -f replay-viewer/dist/ctf_replay.wasm && \
  test -f replay-viewer/dist/ctf_replay.data && \
  test -f replay-viewer/dist/index.html && \
  test -f replay-viewer/dist/league.html && \
  test -s replay-viewer/dist/wire_constants.js && \
  grep -q '^window.CTF_WIRE={' replay-viewer/dist/wire_constants.js && \
  grep -q 'wire_constants.js' replay-viewer/dist/index.html && \
  grep -q 'wire_constants.js' replay-viewer/dist/league.html && \
  test -s replay-viewer/dist/chrome_common.js && \
  grep -q 'window.ChromeCommon' replay-viewer/dist/chrome_common.js && \
  grep -q 'chrome_common.js' replay-viewer/dist/index.html && \
  grep -q 'chrome_common.js' replay-viewer/dist/league.html && \
  test -f replay-viewer/dist/soldier_red_front.png && \
  test -f replay-viewer/dist/soldier_blue_front.png && \
  test -f replay-viewer/dist/soldier_green_front.png && \
  test -f replay-viewer/dist/soldier_yellow_front.png && \
  test -f replay-viewer/dist/soldier_red_front_gun.png && \
  test -f replay-viewer/dist/soldier_blue_front_gun.png && \
  test -f replay-viewer/dist/soldier_green_front_gun.png && \
  test -f replay-viewer/dist/soldier_yellow_front_gun.png && \
  test -f replay-viewer/dist/art/walls/wall_h.jpg && \
  test -f replay-viewer/dist/art/lockerroom/bg.jpg && \
  test -f replay-viewer/dist/art/lockerroom/green_1.webp && \
  test -f replay-viewer/dist/art/lockerroom/red_6.webp
