{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "shooter",
    "team",
    "ctf",
    "doubles",
    "paintball"
  ],
  "game": {
    "name": "paintbot",
    "replay_viewer": {
      "bundle": "static-replay-viewer"
    },
    "description": "Paintbot: paintball-flavored capture-the-heart, AI bots only. Every episode seats FOUR entrant policies, alternating three shapes on randomly generated terrain: 2v2 - the classic two-sided game with each team split between two policies (4 agents each, allies you don't control; coordination via shouts matters double) - 4ffa - 16 seats, four teams (red, blue, green, yellow), one policy per team (4 agents each), each defending its own heart on a square corner or plus map, where every team antes a point and the winner takes the pot (+4 to the winner, -1 to each loser; 2v2 pays +2/-2) - and 4ffa8 - the same four-team game at double muster: 32 seats, 8 agents per team, always on a giant map. Core rules are identical to ctf. A two-team capture-the-heart shooter with fog-of-war vision. Red and Blue spawn on opposite edges, each guarding a heart on its home pedestal. Steal the enemy heart and carry it home - or wipe the enemy team. Two med kits on the center line heal the hurt back to full and respawn after 30 seconds. Grenade pickups wait in the corners: charged throws sail over walls and burst on landing, heard but not seen through the fog. Two plasma arcs spawn high in the side back columns: a carried arc disables your gun and turns the trigger into a forward plasma cone - 5 squares of reach, 2.5 squares wide at the tip - that stays lit for 5 ticks, takes 20 ticks to reset, and deals 3 damage per touch (lethal to a bare cog; a shield carrier survives one). One shield sits low in each endzone's back column, vertically opposite the plasma arcs: carrying it grants 6 hit points but makes your fire rate 3x slower. Both are lost on death and respawn 30 seconds after being taken (see docs/RULES.md, Plasma arc and Shields). Aim is decoupled from movement and carries your vision cone; guns are 3-hit-point hitscan with a trigger windup, a fixed 1050px range on every map, and lightly fuzzed aim (80% to hit a fully visible target at max range, near-certain closer in); the vision cone reaches 1.5x the gun range, teammates are fogged like enemies, and unseen gunfire is heard as a jittered sound ring - never pinpointed. Players can shout: 10-character messages heard within a fifth of the field, tagged by player and team at jittered coordinates and drawn as speech bubbles in replays. Rendered in painted high-resolution art: player observation coordinates are 1x map scale, and the grenade throw is player-input bit 7 / value 128 (see docs/PROTOCOL.md).",
    "owner": "treeform@softmax.com",
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": [
        "/bin/ctf"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-ctf/tree/main"
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "players"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player slot, indexed by slot.",
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "players": {
          "description": "One player display-name object per player slot, indexed by slot.",
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "slots": {
          "description": "Optional fixed player slot team, color, skin, and token settings.",
          "type": "array",
          "maxItems": 32,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "token": {
                "type": "string"
              },
              "team": {
                "type": "string",
                "enum": [
                  "red",
                  "blue",
                  "green",
                  "yellow"
                ],
                "description": "Fixed team for this seat. Green and yellow are only valid when teams is 4; with no team the seat is dealt slot mod teams."
              },
              "skin": {
                "description": "Cosmetic body-art skin for this slot's player. Rendering only: no gameplay effect and no observation-label change.",
                "type": "string",
                "enum": [
                  "default",
                  "crown"
                ]
              },
              "color": {
                "type": "string",
                "enum": [
                  "red",
                  "orange",
                  "yellow",
                  "light blue",
                  "pink",
                  "lime",
                  "blue",
                  "pale blue",
                  "gray",
                  "white",
                  "dark brown",
                  "brown",
                  "dark teal",
                  "green",
                  "dark navy",
                  "black"
                ]
              }
            }
          }
        },
        "closedRoster": {
          "description": "Reject players outside the configured token/slot roster.",
          "type": "boolean",
          "default": false
        },
        "seed": {
          "description": "Random seed.",
          "type": "integer",
          "default": 679961
        },
        "minPlayers": {
          "description": "Players needed before the game countdown starts.",
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 16
        },
        "lives": {
          "description": "Lives per player. Out of lives = out for the round.",
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "hitPoints": {
          "description": "Hit points per life. Each shot removes one; at zero you die.",
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "respawnTicks": {
          "description": "Ticks dead before respawning at home (~3s at 24 ticks/s).",
          "type": "integer",
          "minimum": 0,
          "default": 72
        },
        "gunRange": {
          "description": "Maximum hitscan gun range in pixels.",
          "type": "integer",
          "minimum": 1,
          "default": 1300
        },
        "fireCooldownTicks": {
          "description": "Minimum ticks between shots (~0.5s at 24 ticks/s).",
          "type": "integer",
          "minimum": 0,
          "default": 12
        },
        "carrierSpeedPct": {
          "description": "Movement speed percentage while carrying the heart.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 70
        },
        "aimTurnRate": {
          "description": "Aim rotation speed in brads (256ths of a turn) per tick while a rotate button is held. B rotates counter-clockwise, Select clockwise; movement never changes the aim.",
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "visionConeDeg": {
          "description": "Vision cone half-angle in degrees around the aim angle. Fog of war hides everything outside the cone, the vision bubble, and line of sight.",
          "type": "integer",
          "minimum": 0,
          "maximum": 180,
          "default": 45
        },
        "visionBubble": {
          "description": "Omnidirectional vision radius in pixels around each player, seen regardless of aim.",
          "type": "integer",
          "minimum": 0,
          "default": 90
        },
        "startWaitTicks": {
          "description": "Lobby countdown ticks after enough players join.",
          "type": "integer",
          "minimum": 0,
          "default": 120
        },
        "lobbyJoinTimeoutTicks": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Finite matches only: abort the lobby when the roster is still short of minPlayers after this many lobby ticks (24 ticks = 1s), declaring the stuck seat via COGAME_PLAYER_FAILURE_URI so the platform charges the no-show to that policy. 0 = wait forever (default). The clock runs on lobby ticks, so board bake time never eats the budget."
        },
        "gameOverTicks": {
          "description": "Game over display duration in ticks.",
          "type": "integer",
          "minimum": 0,
          "default": 360
        },
        "maxTicks": {
          "description": "Maximum game ticks before tiebreak, where 0 means no limit.",
          "type": "integer",
          "minimum": 0,
          "default": 10000
        },
        "maxGames": {
          "description": "Maximum games before shutdown.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "showPlayerLabels": {
          "description": "Show player labels.",
          "type": "boolean",
          "default": true
        },
        "fastMode": {
          "description": "Advance frames early when all players report ready.",
          "type": "boolean",
          "default": true
        },
        "mapPath": {
          "description": "Arena map identifier (procedurally generated).",
          "type": "string",
          "default": "arena"
        },
        "num_agents": {
          "description": "Number of agent seats; must equal the player slot count. Used by the platform ladder service for block seating.",
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 16
        },
        "fireWindupTicks": {
          "description": "Ticks from trigger pull to the shot releasing (~0.2s at 24 ticks/s). Aim locks at the pull; a peeking target can duck back behind cover before the bullet leaves.",
          "type": "integer",
          "minimum": 0,
          "default": 5
        },
        "teams": {
          "description": "Active team count: 2 (classic sides) or 4 (corner/plus free-for-all).",
          "type": "integer",
          "enum": [
            2,
            4
          ]
        },
        "mapLayout": {
          "description": "Generated-map layout lock: sides, corners, or plus. Empty draws corners/plus from the map seed for 4-team games.",
          "type": "string",
          "enum": [
            "sides",
            "corners",
            "plus"
          ]
        },
        "mapSeed": {
          "description": "Terrain seed for mapPath gen/pool; -1 derives from the per-episode game seed.",
          "type": "integer"
        },
        "scoring": {
          "description": "End-of-game reward rule. \"classic\": the winning team scores +1 per losing team and each loser -1. \"pot\": every team antes one point and the winning team takes the whole pot, the losing teams splitting the forfeit evenly - 2 teams pay +2/-2, 4 teams pay +4/-1/-1/-1.",
          "type": "string",
          "enum": [
            "classic",
            "pot"
          ],
          "default": "classic"
        },
        "mapSize": {
          "description": "Generated-map size-class lock: small, standard, large, huge, or giant. Empty draws the size from the map seed.",
          "type": "string",
          "enum": [
            "small",
            "standard",
            "large",
            "huge",
            "giant"
          ]
        },
        "handicaps": {
          "description": "Per-team handicap that weakens a team, keyed by team name. Each value is 0..1: 0 = normal, 1 = 50% of shots miss, 1 life, 1 hit point, half max speed; values in between interpolate linearly. Omitted teams are unhandicapped. Intended for a league (e.g. Campaign) to level a dominating team.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "red": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "blue": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "green": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "yellow": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scores"
      ],
      "properties": {
        "names": {
          "description": "One player name or address per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "description": "One scalar score per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "number"
          }
        },
        "win": {
          "description": "One win flag per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "boolean"
          }
        },
        "team": {
          "description": "One team name (red or blue) per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "kills": {
          "description": "One kill count per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "deaths": {
          "description": "One death count per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "captures": {
          "description": "One heart-capture count per player slot.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-ctf/blob/main/docs/PROTOCOL.md"
