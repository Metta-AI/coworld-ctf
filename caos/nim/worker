#!/usr/bin/env bash
# The image's trampoline (the std/bash pattern). The caos runner runs us as
# /worker with /cas set up and the args materialized as placeholders under
# /cas/args. We are an interpreter, not a job: fetch the next executable in the
# chain (`worker1` — the script that IS this job) and run it with bash.
#
# env shebang deliberately: this image has bash at /bin/bash, but the nix
# builder images that may exec this have only the profile's, and /usr/bin/env
# is the portable meeting point (the flake-builder's caos delta guarantees it).
set -euo pipefail
caos get /cas/args/worker1
bash /cas/args/worker1
# caos reads the hash of /cas/out on exit. A script that produced no result
# still has to leave something readable there.
if [ ! -e /cas/out ]; then
  : > /tmp/caos-empty-out
  caos put /tmp/caos-empty-out /cas/out
fi
