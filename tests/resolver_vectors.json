  {
    "name": "resolve-determinism-reorder",
    "description": "Same claimants, listed in the input array in the reverse of standing order (worst-first): the resolver sorts internally, so alice (best standing) still keeps red and the others still bump in standing order regardless of array position.",
    "input": {
      "op": "resolve",
      "palette": {
        "version": 1,
        "colors": [
          { "slug": "red", "wire": "red" },
          { "slug": "blue", "wire": "blue" },
          { "slug": "green", "wire": "green" },
          { "slug": "yellow", "wire": "yellow" },
          { "slug": "teal", "wire": null },
          { "slug": "purple", "wire": null },
          { "slug": "magenta", "wire": null },
          { "slug": "orange", "wire": null }
        ]
      },
      "claimants": [
        { "player": "carol", "standing": 1300, "requested_slug": "red" },
        { "player": "bob", "standing": 1400, "requested_slug": "red" },
        { "player": "alice", "standing": 1500, "requested_slug": "red" }
      ]
    },
    "expected": {
      "grants": {
        "alice": { "requested": "red", "granted": "red", "takenBy": [] },
        "bob": {
          "requested": "red",
          "granted": "blue",
          "takenBy": [ { "slug": "red", "by": "alice" } ]
        },
        "carol": {
          "requested": "red",
          "granted": "green",
          "takenBy": [
            { "slug": "red", "by": "alice" },
            { "slug": "blue", "by": "bob" }
          ]
        }
      }
    }
  },
