{
  "$comment": "\u00a74.3 \u2014 one entry of the per-seat durable status list. The COMPLETE canonical serialized value (escaping included) is \u2264 StatusEntryMaxBytes (256); reasons and parameter paths are truncated to fit. Every entry carries its server-assigned monotonic ordinal and its immutable origin generation. u64 fields are decimal strings (README). Per-kind field requirements are enforced by the allOf arm rules (review finding: all-optional arms let incompatible producers pass). DIRECTION RULE: engine-outbound \u2014 every object in this tree is additionalProperties:true; decoders ignore unknown fields (\u00a75).",
  "title": "status_entry",
  "type": "object",
  "required": [
    "kind",
    "ordinal",
    "gen"
  ],
  "additionalProperties": true,
  "properties": {
    "kind": {
      "enum": [
        "module_accepted",
        "module_ready",
        "module_rejected",
        "call_accepted",
        "call_rejected",
        "retune_refused",
        "play_faulted"
      ]
    },
    "ordinal": {
      "$ref": "uint64.schema.json",
      "$comment": "u64"
    },
    "gen": {
      "$ref": "uint64.schema.json",
      "$comment": "u64 origin generation: the control generation at admission (for an upload's terminal entry, the ADMISSION generation even when compilation finishes after a bump), or the autonomous event's"
    },
    "upload_id": {
      "$ref": "uint64.schema.json",
      "$comment": "u64; module_accepted / module_ready / module_rejected"
    },
    "proposal_id": {
      "$ref": "uint64.schema.json",
      "$comment": "u64; call_accepted / call_rejected"
    },
    "name": {
      "type": "string",
      "$comment": "module_ready: the manifest-declared bound name"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "$comment": "module_ready: the content hash the name bound to"
    },
    "epoch": {
      "$ref": "uint64.schema.json",
      "$comment": "u64; call_accepted / retune_refused / play_faulted"
    },
    "tick": {
      "type": "integer",
      "$comment": "call_accepted: the tick the call became the current declaration"
    },
    "entry_id": {
      "type": "string",
      "$comment": "retune_refused / play_faulted"
    },
    "reason": {
      "type": "string",
      "$comment": "module_rejected / call_rejected (carries the offending parameter path) / retune_refused / play_faulted; truncated to fit the 256-byte entry cap"
    },
    "code": {
      "type": "string",
      "enum": [
        "unknown",
        "outOfFuel",
        "epochDeadline",
        "unreachable",
        "stackOverflow",
        "memoryOutOfBounds",
        "tableOutOfBounds",
        "indirectCallToNull",
        "badSignature",
        "integerOverflow",
        "integerDivisionByZero",
        "badConversionToInteger",
        "trap",
        "hostError",
        "returnedNonzero",
        "refused",
        "abiViolation",
        "instantiateFailed",
        "retuneAbsent"
      ],
      "$comment": "retune_refused / play_faulted: the stable cause (engine FaultCode). Guest trap kinds are wasmtime's trap codes; the rest are engine ABI verdicts. Never trimmed; `reason` is the human text with the cause first."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "module_accepted"
          }
        }
      },
      "then": {
        "required": [
          "upload_id"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "proposal_id"
              ]
            },
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "epoch"
              ]
            },
            {
              "required": [
                "tick"
              ]
            },
            {
              "required": [
                "entry_id"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "code"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "module_ready"
          }
        }
      },
      "then": {
        "required": [
          "upload_id",
          "name",
          "sha256"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "proposal_id"
              ]
            },
            {
              "required": [
                "epoch"
              ]
            },
            {
              "required": [
                "tick"
              ]
            },
            {
              "required": [
                "entry_id"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "code"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "module_rejected"
          }
        }
      },
      "then": {
        "required": [
          "upload_id",
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "proposal_id"
              ]
            },
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "epoch"
              ]
            },
            {
              "required": [
                "tick"
              ]
            },
            {
              "required": [
                "entry_id"
              ]
            },
            {
              "required": [
                "code"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "call_accepted"
          }
        }
      },
      "then": {
        "required": [
          "proposal_id",
          "epoch",
          "tick"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "upload_id"
              ]
            },
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "entry_id"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "code"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "call_rejected"
          }
        }
      },
      "then": {
        "required": [
          "proposal_id",
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "upload_id"
              ]
            },
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "epoch"
              ]
            },
            {
              "required": [
                "tick"
              ]
            },
            {
              "required": [
                "entry_id"
              ]
            },
            {
              "required": [
                "code"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "retune_refused",
              "play_faulted"
            ]
          }
        }
      },
      "then": {
        "required": [
          "code",
          "epoch",
          "entry_id",
          "reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "upload_id"
              ]
            },
            {
              "required": [
                "proposal_id"
              ]
            },
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "tick"
              ]
            }
          ]
        }
      }
    }
  ]
}
